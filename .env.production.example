# คัดลอกเป็น .env บน server (public_html/devtrin/.env) แล้วเติมค่าที่ว่าง — ห้าม commit .env จริง
APP_NAME=Devtrin
APP_ENV=production
APP_KEY=            # สร้างบนเครื่องตัวเอง: php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
APP_URL=https://devtrin.com
APP_LOCALE=th
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# /_maintenance (uptime monitor) และ public/recover.php — สุ่ม: openssl rand -hex 32
MAINTENANCE_TOKEN=

# ปุ่มอัปเดตใน /_maintenance — GitHub fine-grained token เฉพาะ repo trindev/devtrin สิทธิ์ Contents: Read-only
GITHUB_REPO=trindev/devtrin
GITHUB_TOKEN=

# อีเมล (ส่ง + อ่านกล่องเข้าที่ /admin/mail) — บัญชีอีเมลของโดเมนใน DirectAdmin เช่น hello@devtrin.com
MAIL_MAILER=smtp
MAIL_HOST=mail.devtrin.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Devtrin"
# IMAP ไม่ตั้ง = ใช้ host/บัญชีเดียวกับ SMTP (port 993 ssl)
MAIL_WEBMAIL_URL=https://devtrin.com/roundcube

# เข้าสู่ระบบด้วย Google (ผู้เข้าชมที่จะแชท) — Google Cloud Console > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: https://devtrin.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push: ไม่ต้องตั้ง ระบบสร้างคีย์ VAPID เองแล้วเก็บเข้ารหัสในฐานข้อมูล (ตั้งเองได้ถ้าต้องการ)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
